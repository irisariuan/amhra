# Credentials. Copy to .env and fill in; .env is gitignored.
#
# These used to live in data/setting.json. They were moved because that file is
# edited through the dashboard, served to it as a schema, written by the setup
# tools, and easy to copy around while debugging — none of which should be true
# of a bot token. Everything that is not a credential stays in setting.json.
#
# Read them through lib/secrets.ts rather than process.env directly.

# Production bot token. Required to start with --prod.
TOKEN=

# Development bot token. Required to start in development mode.
TESTING_TOKEN=

# OAuth2 client secret, exchanged for user tokens by the dashboard login.
# Only needed if the dashboard is used.
OAUTH_TOKEN=

# SHA-256 of "Basic <password>", from `bun tools/hash.ts`.
# Currently unread by the bot — the dashboard authenticates against accounts in
# the database instead — but kept here because it is a credential, and the
# setup tool still offers it.
AUTH_TOKEN=

# Prisma connection string.
DATABASE_URL=
